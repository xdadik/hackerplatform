# Aegis Platform — environment template
# Copy to .env.local (never commit real secrets) and fill in the values.
# Supabase keys: Project Settings -> API in the Supabase dashboard.

# --- Admin panel login (server-only, never NEXT_PUBLIC) ---
ADMIN_USER=admin
# Strong password (min 12 chars). Also acts as the HMAC key signing the
# aegis_admin_session cookie. CHANGE THIS before going live.
ADMIN_PASS=

# Signs admin tokens in addition to ADMIN_PASS. Random 32+ char string:
#   openssl rand -hex 32
NEXTAUTH_SECRET=

# --- Supabase (project rijdajzrkpuuochzwcsk) ---
NEXT_PUBLIC_SUPABASE_URL=https://rijdajzrkpuuochzwcsk.supabase.co
# Anon/public key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Misc ---
NEXT_PUBLIC_APP_VERSION=0.1.0
