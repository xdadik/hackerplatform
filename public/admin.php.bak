  <div class="bg-white border border-zinc-200 rounded-[12px] overflow-hidden">
    <div class="p-4 border-b flex items-center justify-between gap-3">
      <div class="text-[14px] font-semibold">Users — <?=count($users)?></div>
      <form method="post" class="flex gap-2">
        <input name="username" placeholder="username" required class="h-8 w-[120px] rounded-[8px] border border-zinc-300 px-2 text-[13px]">
