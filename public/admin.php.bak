      <table class="w-full text-left text-[13px]"><thead class="bg-zinc-50 border-y border-zinc-200 text-[11px] tracking-widest uppercase text-zinc-500"><tr><th class="px-4 py-2.5">Article</th><th class="px-4 py-2.5">Author</th><th class="px-4 py-2.5">Status</th><th class="px-4 py-2.5 text-right">Actions</th></tr></thead>
