session_start();

// --- CONFIG ---
define('ADMIN_USER', 'admin');
define('ADMIN_PASS', 'Aegis2026!'); // change in production
define('DATA_DIR', __DIR__ . '/../data');
define('VIDEO_DIR', __DIR__ . '/videos');

// Ensure data dirs exist
if (!is_dir(DATA_DIR)) mkdir(DATA_DIR, 0755, true);
if (!is_dir(VIDEO_DIR)) mkdir(VIDEO_DIR, 0755, true);

$usersFile = DATA_DIR . '/users.json';
$eventsFile = DATA_DIR . '/events.json';
$newsFile = DATA_DIR . '/news.json';

// Init files if missing - demo accounts deleted, starts empty (product-ready)
if (!file_exists($usersFile)) file_put_contents($usersFile, json_encode([], JSON_PRETTY_PRINT));
if (!file_exists($eventsFile)) file_put_contents($eventsFile, json_encode([
  ["id"=>1,"title"=>"Winter CTF 2026","type"=>"CTF","date"=>"2026-01-15","status"=>"Live","participants"=>342],
  ["id"=>2,"title"=>"SOC Simulation — Feb 22","type"=>"Workshop","date"=>"2026-02-22","status"=>"Upcoming","participants"=>48],
], JSON_PRETTY_PRINT));
if (!file_exists($newsFile)) file_put_contents($newsFile, json_encode([
  ["id"=>1,"title"=>"Abusing Overly Permissive IAM Trust Policies","author"=>"Sophia Chen","tags"=>"aws,iam","views"=>3421,"status"=>"Published"],
  ["id"=>2,"title"=>"Heap Feng Shui in glibc 2.39","author"=>"Marcus Reid","tags"=>"pwn,heap","views"=>1823,"status"=>"Published"],
], JSON_PRETTY_PRINT));

function loadJson($file){ $c=file_get_contents($file); $d=json_decode($c,true); return is_array($d)?$d:[];}
function saveJson($file,$data){ file_put_contents($file, json_encode($data, JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE)); }

$users = loadJson($usersFile);
$events = loadJson($eventsFile);
$news = loadJson($newsFile);

// --- RATE LIMITING (5 attempts per 15 min per IP) ---
define('ATTEMPTS_FILE', DATA_DIR . '/admin_attempts.json');
function getAttempts($ip){
  if(!file_exists(ATTEMPTS_FILE)) return [];
  $d=json_decode(file_get_contents(ATTEMPTS_FILE),true);
  return is_array($d)?($d[$ip]??[]):[];
}
function recordAttempt($ip,$success){
  $data=file_exists(ATTEMPTS_FILE)?json_decode(file_get_contents(ATTEMPTS_FILE),true):[];
  if(!is_array($data)) $data=[];
  $now=time();
  $data[$ip]=array_filter($data[$ip]??[], fn($t)=>$now-$t<900); // 15 min
  if(!$success) $data[$ip][]=$now;
  else $data[$ip]=[]; // reset on success
  file_put_contents(ATTEMPTS_FILE, json_encode($data, JSON_PRETTY_PRINT));
}
function isRateLimited($ip){
  $a=getAttempts($ip);
  $a=array_filter($a, fn($t)=>time()-$t<900);
  return count($a)>=5;
}

// --- CSRF ---
if(empty($_SESSION['csrf'])) $_SESSION['csrf']=bin2hex(random_bytes(32));
function csrfValid(){ return isset($_POST['csrf']) && hash_equals($_SESSION['csrf'], $_POST['csrf']); }

// --- AUTH ---
if (isset($_GET['logout'])) { session_destroy(); header("Location: admin.php"); exit; }

if (isset($_POST['login'])) {
  $ip=$_SERVER['REMOTE_ADDR']??'127.0.0.1';
  if(isRateLimited($ip)){
    $error = "Too many attempts. Try again in 15 minutes (rate limited).";
  } else {
    $u = trim($_POST['username'] ?? '');
    $p = $_POST['password'] ?? '';
    // Basic sanitization
    $u = htmlspecialchars($u, ENT_QUOTES);
    if ($u === ADMIN_USER && $p === ADMIN_PASS) {
      recordAttempt($ip,true);
      $_SESSION['admin_logged'] = true;
      $_SESSION['admin_user'] = ADMIN_USER;
      // Regenerate session ID to prevent fixation
      session_regenerate_id(true);
      header("Location: admin.php");
      exit;
    } else {
      recordAttempt($ip,false);
      $remaining = 5 - count(getAttempts($ip));
      $error = "Invalid login or password. Attempts left: ".max(0,$remaining);
    }
  }
}

if (!isset($_SESSION['admin_logged'])) {
  // Security headers for login page
  header("X-Frame-Options: DENY");
  header("X-Content-Type-Options: nosniff");
  header("Referrer-Policy: strict-origin-when-cross-origin");
  ?>
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin Login — Aegis</title>
<script src="https://cdn.tailwindcss.com"></script></head>
<body class="min-h-screen bg-[#FAFAF9] flex items-center justify-center p-4">
<div class="w-full max-w-[400px] bg-white border border-zinc-200 rounded-[16px] shadow-sm p-6">
  <div class="w-10 h-10 rounded-full bg-zinc-900 text-white flex items-center justify-center mx-auto text-[14px] font-bold">A</div>
  <h1 class="mt-4 text-center text-[20px] font-bold tracking-tight">Admin Login</h1>
  <p class="text-center text-[13px] text-zinc-500 mt-1">Aegis Platform — Control Panel</p>
  <p class="text-center text-[11px] text-zinc-400">Rate limited: 5 attempts / 15 min per IP</p>
  <?php if(!empty($error)): ?><div class="mt-4 p-3 rounded-[8px] bg-red-50 border border-red-200 text-[13px] text-red-700"><?=htmlspecialchars($error)?></div><?php endif; ?>
  <form method="post" class="mt-6 space-y-4">
    <input type="hidden" name="csrf" value="<?=htmlspecialchars($_SESSION['csrf'])?>">
    <div><label class="text-[12px] font-medium">Username</label><input name="username" required placeholder="admin" autocomplete="username" class="mt-1 w-full h-10 rounded-[8px] border border-zinc-300 px-3 text-[14px] focus:outline-none focus:ring-2 focus:ring-zinc-900" /></div>
    <div><label class="text-[12px] font-medium">Password</label><input name="password" type="password" required placeholder="••••••••" autocomplete="current-password" class="mt-1 w-full h-10 rounded-[8px] border border-zinc-300 px-3 text-[14px]" /></div>
    <button name="login" value="1" class="w-full h-10 rounded-[8px] bg-zinc-900 text-white font-semibold hover:bg-zinc-800">Log in</button>
    <p class="text-center text-[11px] text-zinc-500">Default: <code class="bg-zinc-100 px-1.5 py-0.5 rounded">admin / Aegis2026!</code></p>
  </form>
</div>
</body></html>
<?php exit; }

// Security headers for admin panel
header("X-Frame-Options: SAMEORIGIN");
header("X-Content-Type-Options: nosniff");
header("Referrer-Policy: strict-origin-when-cross-origin");
header("Content-Security-Policy: default-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://fonts.googleapis.com; img-src 'self' data:;");

// --- ACTIONS when logged in (CSRF protected) ---
$msg = "";
if ($_SERVER['REQUEST_METHOD']==='POST' && !csrfValid()) {
  $msg="Security error: CSRF validation failed";
} else {
if (isset($_POST['add_user'])) {
  $u = htmlspecialchars(trim($_POST['username'] ?? ''), ENT_QUOTES);
  $e = filter_var(trim($_POST['email'] ?? ''), FILTER_SANITIZE_EMAIL);
  $r = in_array($_POST['role']??'user',['user','moderator','admin'])?$_POST['role']:'user';
  $s = in_array($_POST['status']??'Active',['Active','Pending','Banned'])?$_POST['status']:'Active';
  if ($u && $e && filter_var($e, FILTER_VALIDATE_EMAIL)) {
    $users[] = ["id"=>time(),"username"=>$u,"email"=>$e,"role"=>$r,"status"=>$s,"reputation"=>0];
    saveJson($usersFile,$users);
    $msg="User added";
  } else $msg="Invalid username/email";
}
if (isset($_POST['delete_user'])) {
  $id = preg_replace('/[^0-9]/','', $_POST['delete_user']);
  $users = array_values(array_filter($users, fn($x)=> (string)$x['id'] !== (string)$id));
  saveJson($usersFile,$users);
  $msg="User deleted";
}
if (isset($_POST['reset_pass'])) {
  $id = preg_replace('/[^0-9]/','', $_POST['reset_pass']);
  $new = substr(bin2hex(random_bytes(4)),0,8);
  $msg="Password for user #$id reset to: $new (simulated - hash and store in production)";
}
if (isset($_POST['toggle_user_status'])) {
  $id = preg_replace('/[^0-9]/','', $_POST['toggle_user_status']);
  foreach($users as &$u){ if((string)$u['id']===(string)$id){ $u['status'] = $u['status']==="Active"?"Banned":"Active"; break; } }
  saveJson($usersFile,$users);
  $msg="User status toggled";
}
if (isset($_POST['add_event'])) {
  $t = htmlspecialchars(trim($_POST['title'] ?? ''), ENT_QUOTES);
  $ty = in_array($_POST['type']??'CTF',['CTF','Workshop','Competition'])?$_POST['type']:'CTF';
  $d = preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['date']??'')?$_POST['date']:date('Y-m-d');
  if($t){ $events[]=["id"=>time(),"title"=>$t,"type"=>$ty,"date"=>$d,"status"=>"Upcoming","participants"=>0]; saveJson($eventsFile,$events); $msg="Event created"; }
}
if (isset($_POST['delete_event'])) {
  $id=preg_replace('/[^0-9]/','', $_POST['delete_event']); $events=array_values(array_filter($events, fn($x)=>(string)$x['id']!==(string)$id)); saveJson($eventsFile,$events); $msg="Event deleted";
}
if (isset($_POST['add_news'])) {
  $t=htmlspecialchars(trim($_POST['title']??''), ENT_QUOTES); $a=htmlspecialchars(trim($_POST['author']??'Admin'), ENT_QUOTES); $tags=htmlspecialchars(trim($_POST['tags']??''), ENT_QUOTES);
  if($t){ $news[]=["id"=>time(),"title"=>$t,"author"=>$a,"tags"=>$tags,"views"=>0,"status"=>"Published","excerpt"=>htmlspecialchars(trim($_POST['excerpt']??''), ENT_QUOTES)]; saveJson($newsFile,$news); $msg="News published"; }
}
if (isset($_POST['delete_news'])) {
  $id=preg_replace('/[^0-9]/','', $_POST['delete_news']); $news=array_values(array_filter($news, fn($x)=>(string)$x['id']!==(string)$id)); saveJson($newsFile,$news); $msg="News deleted";
}
if (isset($_POST['upload_video']) && isset($_FILES['video'])) {
  $f = $_FILES['video'];
  // Validate file type and size (max 500MB)
  $allowed = ['video/mp4','video/webm','video/ogg'];
  if($f['error']===0 && $f['size'] < 500*1024*1024 && in_array($f['type'], $allowed)){
    $name = preg_replace('/[^a-zA-Z0-9._-]/','_', $f['name']);
    $ext = strtolower(pathinfo($name, PATHINFO_EXTENSION));
    if(!in_array($ext,['mp4','webm','ogg'])) $msg="Invalid extension";
    else {
      $dest = VIDEO_DIR . '/' . time() . '_' . $name;
      if(move_uploaded_file($f['tmp_name'], $dest)){
        $msg="Video uploaded: ".htmlspecialchars(basename($dest));
      } else $msg="Upload failed (permissions)";
    }
  } else $msg="Upload error: invalid type/size ".htmlspecialchars($f['type']??'');
}
if (isset($_POST['delete_video'])) {
  $v = basename($_POST['delete_video']);
  // Prevent path traversal
  $v = preg_replace('/[^a-zA-Z0-9._-]/','', $v);
  $path = VIDEO_DIR . '/' . $v;
  // Ensure path is inside VIDEO_DIR
  if(strpos(realpath($path)?:$path, realpath(VIDEO_DIR))===0 && file_exists($path)) unlink($path);
  $msg="Video deleted: ".htmlspecialchars($v);
}
} // end CSRF wrapper

$users = loadJson($usersFile);
$events = loadJson($eventsFile);
$news = loadJson($newsFile);
$videos = array_values(array_filter(scandir(VIDEO_DIR), fn($x)=>!in_array($x,['.','..'])));

$tab = $_GET['tab'] ?? 'overview';
$allowed = ['overview','users','videos','events','news','system'];
if(!in_array($tab,$allowed)) $tab='overview';
?>
